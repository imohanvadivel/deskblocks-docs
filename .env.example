# Algolia configuration for the docs-site search.
#
# Copy this file to `.env` and fill in the values. All three are read through
# SvelteKit's `$env/static/public`, which means they are inlined into the client
# bundle and are visible to anyone who views the site. Only ever put values here
# that are safe to publish.
#
# If any of the three are left empty the search UI degrades on purpose: the
# header input stays visible but disabled, and one warning is logged to the
# console. Nothing else on the site is affected.

# Algolia Application ID.
# Dashboard > Settings > API keys. Current docs app: PNC260SS8B
PUBLIC_ALGOLIA_APP_ID=

# Algolia API key. This MUST be the **Search-Only API Key**.
# NEVER put the Admin API Key (or any key with write/ACL permissions) here — it
# is shipped to the browser in plain text. Dashboard > Settings > API keys >
# "Search-Only API Key".
PUBLIC_ALGOLIA_SEARCH_KEY=

# Name of the index the DocSearch crawler writes to.
# Current docs index: deskblocks-mohanvadivel
PUBLIC_ALGOLIA_INDEX=
